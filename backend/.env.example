# Khoj backend configuration. Copy to `.env` and adjust.
# Every value below has a working default — the API runs with no .env at all.

NODE_ENV=development
PORT=5000

# MongoDB connection string. Inside docker-compose this becomes
# mongodb://mongo:27017/khoj (the service name resolves on the compose network).
MONGO_URI=mongodb://127.0.0.1:27017/khoj

# FastAPI ml-service (CV parsing + match scoring). The browser never calls it
# directly; the backend proxies /api/cv/parse and /api/match/*.
ML_SERVICE_URL=http://localhost:8000
ML_TIMEOUT_MS=30000

# Allowed browser origins, comma-separated. `*` is the default and is
# deliberate: Khoj has no accounts and no per-user data to protect.
CORS_ORIGINS=*

# CV upload ceiling in bytes (5 MB). Parsed CVs are never persisted server-side.
MAX_UPLOAD_BYTES=5242880

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
RATE_LIMIT_INGEST_MAX=30

# Optional shared secret for POST /api/jobs/ingest, sent by the scraper as
# `X-Ingest-Token`. Leave blank in local dev and the endpoint stays open.
# There are still no user accounts anywhere — this only guards the one write path.
INGEST_TOKEN=

# Hide jobs whose deadline passed more than this many days ago.
STALE_AFTER_DAYS=7
