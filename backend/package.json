{
  "name": "khoj-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Khoj API — public job aggregation + CV match proxy (no auth)",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles --forceExit",
    "test:unit": "cross-env NODE_ENV=test jest tests/unit --runInBand",
    "dev:memory": "node scripts/dev-with-memory-db.cjs",
    "seed": "node scripts/seed-jobs.js"
  },
  "dependencies": {
    "axios": "1.7.9",
    "compression": "1.7.5",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "form-data": "4.0.1",
    "helmet": "8.0.0",
    "mongoose": "8.9.5",
    "morgan": "1.10.0",
    "multer": "2.0.2"
  },
  "devDependencies": {
    "cross-env": "7.0.3",
    "jest": "29.7.0",
    "mongodb-memory-server": "10.1.3",
    "nodemon": "3.1.9",
    "supertest": "7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "setupFilesAfterEnv": [
      "<rootDir>/tests/jest.setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  }
}
