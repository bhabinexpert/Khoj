# Frontend build-time configuration (Vite). Copy to `.env` for local dev.
#
# Everything here is compiled into the public bundle — never put a secret in a
# VITE_ variable. Khoj has no secrets to put here anyway: the API is public.

# Where the browser sends API calls. Leave as the default relative "/api" so the
# same origin that served the app also proxies the API (nginx in prod, Vite's
# dev proxy locally). Set an absolute URL only for a split-origin deployment.
# VITE_API_BASE_URL=/api

# Dev-only: where Vite's dev-server proxy forwards "/api". Ignored in the build.
VITE_PROXY_TARGET=http://localhost:5000
