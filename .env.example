# Khoj — environment for docker-compose. Copy to `.env` and adjust.
#
# Nothing here is a real secret in the default setup: Khoj has no user accounts
# and the API is public and read-only apart from ingest. The one value worth
# setting for a real deployment is INGEST_TOKEN, which gates the one write
# endpoint (POST /api/jobs/ingest) so only your own scraper can post jobs.

# ---- backend ----------------------------------------------------------------
# Where MongoDB lives. The default points at the `mongo` service in compose.
MONGO_URI=mongodb://mongo:27017/khoj
# Comma-separated allowed browser origins, or * for any (the public default).
CORS_ORIGINS=*
# Shared secret for POST /api/jobs/ingest. Leave blank and the endpoint is open;
# set it and both the backend and the scraper must agree on the value.
INGEST_TOKEN=
# CV upload ceiling in bytes (default 5 MiB).
MAX_UPLOAD_BYTES=5242880

# ---- ml-service -------------------------------------------------------------
# The backend proxies CV parsing and match scoring here. Default is the compose
# service name; the first request downloads the sentence-transformers model.
ML_SERVICE_URL=http://ml-service:8000
ML_TIMEOUT_MS=30000

# ---- scraper-service --------------------------------------------------------
# Where the scraper posts the jobs it finds. Default is the compose backend.
BACKEND_URL=http://backend:5000
# Comma-separated sources to crawl. Available Nepali boards: merojob, jobaxle,
# kumarijob, froxjob, merorojgari, jobsnepal, rojgari, nepalijob. Free remote-job
# APIs (worldwide remote work): himalayas, arbeitnow. Leave unset to run all.
SCRAPER_SOURCES=merojob,jobaxle,kumarijob,froxjob,merorojgari,jobsnepal,rojgari,nepalijob,himalayas,arbeitnow
# Politeness floor between requests, in seconds. Do not lower below the value a
# source's robots.txt Crawl-delay implies.
SCRAPER_MIN_DELAY=3.0
# Hours between scheduled runs when the scraper loops (6–12h is kind to sources).
SCRAPER_INTERVAL_HOURS=8
